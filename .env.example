# Optional. Setup generates a random password if ORBIT_PASSWORD is omitted.
# Use your own password of at least 12 characters; never commit this file with a real password.
ORBIT_PASSWORD=
ORBIT_DATA_DIR=data
# For access through a reverse proxy, set the exact public origin.
ORBIT_PUBLIC_URL=
# Set to 1 only when using HTTPS.
ORBIT_SECURE_COOKIE=0

